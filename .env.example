# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# Example future env vars:
NEXT_PUBLIC_WHOP_LINK=https://whop.com/checkout/plan_LcwR053laq0aV/
NEXT_PUBLIC_DISCORD_LINK=https://discord.gg/your-invite

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Whop API — used to fetch and cache reviews server-side
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_
WHOP_PRODUCT_ID=prod_

# GitHub API — used to fetch and cache contributors server-side
GITHUB_TOKEN=

# CommitPT User Management API (https://usm.commitpt.com/docs) — used to fetch
# public profile data server-side for /u/{username}
USM_API_URL=https://usm.commitpt.com
USM_API_KEY=


